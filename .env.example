# --- Required ---
# Google Cloud key with the "Routes API" and "Maps Static API" enabled
GOOGLE_API_KEY=
HOME_ADDRESS=123 Main St, Springfield, WA
WORK_ADDRESS=500 Office Park Dr, Springfield, WA

# --- Recommended ---
# Accidents, closures and jams along the route (free key at developer.tomtom.com)
TOMTOM_API_KEY=

# --- Optional ---
HOME_LABEL=Home
WORK_LABEL=Work
TIMEZONE=America/Los_Angeles
# Show work -> home from this local hour onwards (e.g. 12). Leave empty to always show home -> work.
REVERSE_AFTER_HOUR=
AVOID_TOLLS=false
AVOID_HIGHWAYS=false
# Auto-detected from the request if empty, e.g. https://your-app.vercel.app
PUBLIC_BASE_URL=
# Secret for signing map URLs; defaults to GOOGLE_API_KEY
MAP_SIGNING_SECRET=
