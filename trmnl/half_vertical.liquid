<div class="layout layout--col gap--small">
  {% if error %}
  <span class="description">{{ error }}</span>
  {% else %}
  <img src="{{ map_url }}&w=380&h=220" alt="Route map" style="width: 100%; height: 45%; object-fit: cover; border-radius: 8px;">
  <div class="flex flex--col gap--xsmall w--full">
    <span class="label label--small">To {{ destination_label }} · arrive {{ arrive_by }}</span>
    <span class="value value--xlarge value--tnums">{{ duration_min }}<span class="title title--small"> min</span></span>
    <span class="description" data-clamp="1">{{ headline }}</span>
    <span class="title title--small" data-clamp="1">Via {{ via }} · {{ distance }}</span>
    <span class="description" data-clamp="2">{{ route_summary }}</span>
    {% for incident in incidents limit: 2 %}
    <span class="label label--small {% if incident.is_accident %}label--inverted{% else %}label--outline{% endif %}" data-clamp="1">{{ incident.number }}. {{ incident.type }}{% if incident.road != "" %} · {{ incident.road }}{% endif %} · {{ incident.ahead }}</span>
    {% endfor %}
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">{{ title | default: "Commute" }}</span>
  <span class="instance">{{ updated_at }}</span>
</div>
