<div class="layout layout--row layout--top gap--medium">
  {% if error %}
  <div class="flex flex--col flex--center-x flex--center-y gap--small w--full h--full">
    <span class="title">Drive time unavailable</span>
    <span class="description">{{ error }}</span>
  </div>
  {% else %}
  <div class="h--full" style="width: 46%; flex-shrink: 0;">
    <img src="{{ map_url }}&w=380&h=430" alt="Route map" style="width: 100%; height: 100%; object-fit: cover; border-radius: 10px;">
  </div>

  <div class="flex flex--col gap--small h--full" style="flex: 1; min-width: 0;">
    <div class="flex flex--col">
      <span class="label label--small">To {{ destination_label }} · arrive {{ arrive_by }}</span>
      <span class="value value--xxlarge value--tnums">{{ duration_min }}<span class="title title--small"> min</span></span>
      <span class="description">{{ headline }}</span>
    </div>

    <div class="divider"></div>

    <div class="flex flex--col">
      <span class="title title--small" data-clamp="1">Via {{ via }} · {{ distance }}</span>
      <span class="description" data-clamp="2">{{ route_summary }}</span>
      <span class="label label--small">Fastest of {{ route_count }} · {{ alternative_summary }}</span>
    </div>

    <div class="divider"></div>

    {% if incidents.size > 0 %}
    <div class="flex flex--col gap--xsmall" style="flex: 1; overflow: hidden;">
      {% for incident in incidents limit: 3 %}
      <div class="item">
        <div class="meta"><span class="index">{{ incident.number }}</span></div>
        <div class="content">
          <span class="title title--small" data-clamp="1">{{ incident.type }}{% if incident.road != "" %} · {{ incident.road }}{% endif %}</span>
          <span class="description" data-clamp="1">{{ incident.where }}</span>
          <div class="flex gap--xsmall">
            <span class="label label--small {% if incident.is_accident %}label--inverted{% else %}label--outline{% endif %}">{{ incident.ahead }}</span>
            {% if incident.delay != "" %}<span class="label label--small label--outline">{{ incident.delay }}</span>{% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
      {% if incidents.size > 3 %}
      <span class="label label--small">+{{ incidents.size | minus: 3 }} more on route</span>
      {% endif %}
    </div>
    {% elsif incidents_enabled %}
    <span class="title title--small">No incidents on your route</span>
    {% endif %}
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">{{ title | default: "Commute" }}</span>
  <span class="instance">Updated {{ updated_at }}</span>
</div>
