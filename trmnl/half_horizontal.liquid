<div class="layout layout--row gap--medium">
  {% if error %}
  <span class="description">{{ error }}</span>
  {% else %}
  <div class="h--full" style="width: 34%; flex-shrink: 0;">
    <img src="{{ map_url }}&w=280&h=200" alt="Route map" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;">
  </div>
  <div class="flex flex--col gap--xsmall" style="flex: 1; min-width: 0;">
    <span class="value value--xlarge value--tnums">{{ duration_min }}<span class="title title--small"> min</span></span>
    <span class="description" data-clamp="1">{{ headline }} · arrive {{ arrive_by }}</span>
    <span class="title title--small" data-clamp="1">Via {{ via }} · {{ distance }}</span>
    <span class="description" data-clamp="1">{{ route_summary }}</span>
    {% for incident in incidents limit: 2 %}
    <span class="label label--small {% if incident.is_accident %}label--inverted{% else %}label--outline{% endif %}" data-clamp="1">{{ incident.number }}. {{ incident.type }}{% if incident.road != "" %} · {{ incident.road }}{% endif %} · {{ incident.ahead }}{% if incident.delay != "" %} · {{ incident.delay }}{% endif %}</span>
    {% endfor %}
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">{{ title | default: "Commute" }}</span>
  <span class="instance">Updated {{ updated_at }}</span>
</div>
